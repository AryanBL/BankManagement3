# Copy to .env.docker and replace every sample password.
# Use unique passwords of at least 12 characters with uppercase, lowercase,
# digits, and a symbol. For the five Bank* SQL logins, avoid: '  "  newline  $(

MSSQL_PID=Developer
MSSQL_SA_PASSWORD=Replace_SA_With_Strong_2026!A9

BANK_APP_PASSWORD=Replace_App_With_Strong_2026!B8
BANK_REPORT_PASSWORD=Replace_Report_With_Strong_2026!C7
BANK_AUDITOR_PASSWORD=Replace_Audit_With_Strong_2026!D6
BANK_HIGHADMIN_REPORT_PASSWORD=Replace_HighReport_With_Strong_2026!E5
BANK_MAINTENANCE_PASSWORD=Replace_Maintenance_With_Strong_2026!F4

# Your native Windows SQL Server uses 14330, so Docker uses 14331 on the host.
# Inside Docker, the backend and initializer always use mssql:1433.
MSSQL_HOST_PORT=14331
BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=5500

MSSQL_MEMORY_LIMIT_MB=2048
SESSION_TTL_MINUTES=10

# Use true only for a new disposable local demonstration database.
LOAD_SAMPLE_DATA=false
INSTALL_AGENT_JOBS=true

# WARNING: true runs the destructive clean-rebuild schema installer.
FORCE_DB_REBUILD=false

CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
