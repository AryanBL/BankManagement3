# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Main application DB connection.
# Recommended: create the SQL Server login BankAppLogin and map it to BankAppUser.
DB_SERVER=localhost
DB_PORT=14330
DB_DATABASE=BankManagement
DB_USER=BankAppLogin
DB_PASSWORD=BankApp_Pass
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_REQUEST_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=15000
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_USE_UTC=false

# Optional read-only connections for report/audit views.
# If you leave these empty, the backend will reuse DB_USER/DB_PASSWORD.
REPORT_DB_USER=BankReportLogin
REPORT_DB_PASSWORD=BankReport
AUDIT_DB_USER=BankAuditorLogin
AUDIT_DB_PASSWORD=BankAudit
HIGHADMIN_REPORT_DB_USER=BankHighAdminReportLogin
HIGHADMIN_REPORT_DB_PASSWORD=BankHighAdminReport
