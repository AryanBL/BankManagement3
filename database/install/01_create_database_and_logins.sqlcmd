/*
  Cross-platform SQLCMD installer.

  Required SQLCMD variables (pass with sqlcmd -v):
    BankAppPassword
    BankReportPassword
    BankAuditorPassword
    BankHighAdminReportPassword
    BankMaintenancePassword

  The project database name is intentionally fixed to BankManagement because
  several application and maintenance scripts use that database name.
*/
:On Error exit
:setvar DbName "BankManagement"

USE [master];
GO

IF DB_ID(N'$(DbName)') IS NULL
BEGIN
    EXEC(N'CREATE DATABASE [$(DbName)]');
END;
GO

IF SUSER_ID(N'BankAppLogin') IS NULL
    CREATE LOGIN [BankAppLogin] WITH PASSWORD = N'$(BankAppPassword)', CHECK_POLICY = ON, CHECK_EXPIRATION = OFF;
ELSE
    ALTER LOGIN [BankAppLogin] WITH PASSWORD = N'$(BankAppPassword)', CHECK_POLICY = ON, CHECK_EXPIRATION = OFF;
GO

IF SUSER_ID(N'BankReportLogin') IS NULL
    CREATE LOGIN [BankReportLogin] WITH PASSWORD = N'$(BankReportPassword)', CHECK_POLICY = ON, CHECK_EXPIRATION = OFF;
ELSE
    ALTER LOGIN [BankReportLogin] WITH PASSWORD = N'$(BankReportPassword)', CHECK_POLICY = ON, CHECK_EXPIRATION = OFF;
GO

IF SUSER_ID(N'BankAuditorLogin') IS NULL
    CREATE LOGIN [BankAuditorLogin] WITH PASSWORD = N'$(BankAuditorPassword)', CHECK_POLICY = ON, CHECK_EXPIRATION = OFF;
ELSE
    ALTER LOGIN [BankAuditorLogin] WITH PASSWORD = N'$(BankAuditorPassword)', CHECK_POLICY = ON, CHECK_EXPIRATION = OFF;
GO

IF SUSER_ID(N'BankHighAdminReportLogin') IS NULL
    CREATE LOGIN [BankHighAdminReportLogin] WITH PASSWORD = N'$(BankHighAdminReportPassword)', CHECK_POLICY = ON, CHECK_EXPIRATION = OFF;
ELSE
    ALTER LOGIN [BankHighAdminReportLogin] WITH PASSWORD = N'$(BankHighAdminReportPassword)', CHECK_POLICY = ON, CHECK_EXPIRATION = OFF;
GO

IF SUSER_ID(N'BankMaintenanceLogin') IS NULL
    CREATE LOGIN [BankMaintenanceLogin] WITH PASSWORD = N'$(BankMaintenancePassword)', CHECK_POLICY = ON, CHECK_EXPIRATION = OFF;
ELSE
    ALTER LOGIN [BankMaintenanceLogin] WITH PASSWORD = N'$(BankMaintenancePassword)', CHECK_POLICY = ON, CHECK_EXPIRATION = OFF;
GO

PRINT 'Database and SQL Server logins are ready. Next run 02_install_bankmanagement_database.sqlcmd.';
GO
