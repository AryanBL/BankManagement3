/*
  Cross-platform SQLCMD installer for reporting views and database security.

  Run SQLCMD from the project root.
*/
:On Error exit
:setvar DbName "BankManagement"

USE [$(DbName)];
GO

SET ANSI_NULLS ON;
SET ANSI_PADDING ON;
SET ANSI_WARNINGS ON;
SET ARITHABORT ON;
SET CONCAT_NULL_YIELDS_NULL ON;
SET QUOTED_IDENTIFIER ON;
SET NUMERIC_ROUNDABORT OFF;
GO

:r "database/security/Views/01_BankManagement_ReportingViews.sql"
:r "database/security/Security/01_DatabaseRolesAndUsers.sql"
:r "database/security/Security/02_DatabasePrivileges.sql"

PRINT 'Security users, roles, permissions, and reporting views installed.';
GO
