/*
  Cross-platform SQLCMD installer for the complete BankManagement schema.

  Run SQLCMD from the project root. All :r include paths are relative to that directory.

  IMPORTANT: TableCreation_FULL_FINAL_SAFE_REBUILD.sql deletes existing project
  data. The Docker/WSL initializer guards this script with a deployment marker
  unless FORCE_DB_REBUILD=true is explicitly selected.
*/
:On Error exit
:setvar DbName "BankManagement"

USE [$(DbName)];
GO

SET ANSI_NULLS ON;
SET ANSI_PADDING ON;
SET ANSI_WARNINGS ON;
SET ARITHABORT ON;
SET CONCAT_NULL_YIELDS_NULL ON;
SET QUOTED_IDENTIFIER ON;
SET NUMERIC_ROUNDABORT OFF;
GO

:r "database/scripts/TableCreation/TableCreation_FULL_FINAL_SAFE_REBUILD.sql"
:r "database/scripts/TableCreation/Expiration_Session_Alter.sql"
:r "database/scripts/Functions/PasswordHash.sql"

:r "database/scripts/Rules/Schema_CustomerAccessAndBranchLedger.sql"
:r "database/scripts/Rules/Schema_AccountModuleSupport_SELF_SERVICE.sql"
:r "database/scripts/Rules/Schema_EmployeeModuleSupport.sql"
:r "database/scripts/Rules/EMPB_PreventDateOverlap.sql"
:r "database/scripts/Rules/ApplyAccessRules.sql"
:r "database/scripts/Rules/99_Function_UserHasEffectiveRole.sql"

:r "database/scripts/Triggers/TransactionTriggers/Trigger_Transactions_EnforceTypePattern_Update.sql"
:r "database/scripts/Triggers/AccountTriggers/Trigger_Account_PreventCloseWithPending.sql"
:r "database/scripts/Triggers/AccountTriggers/Trigger_Account_SyncBranchLedger.sql"
:r "database/scripts/Triggers/CustomerTriggers/Trigger_Customer_PreventDeactivateWithPending.sql"
:r "database/scripts/Triggers/LoanTriggers/Trigger_SyncInstallmentStatus.sql"

:r "database/scripts/StoredProcedures/CustomerProcedures/Procedure_Customer_Create.sql"
:r "database/scripts/StoredProcedures/CustomerProcedures/Procedure_Customer_Update.sql"
:r "database/scripts/StoredProcedures/CustomerProcedures/Procedure_Customer_Delete.sql"
:r "database/scripts/StoredProcedures/CustomerProcedures/Procedure_Customer_Search.sql"

:r "database/scripts/StoredProcedures/UserProcedures/Procedure_HighAdmin_CreateInitialUser.sql"
:r "database/scripts/StoredProcedures/UserProcedures/Procedure_User_SignUp_UPDATED.sql"
:r "database/scripts/StoredProcedures/UserProcedures/Procedure_User_Login.sql"
:r "database/scripts/StoredProcedures/UserProcedures/Procedure_User_Logout.sql"
:r "database/scripts/StoredProcedures/Session/Procedure_User_ValidateSession.sql"

:r "database/scripts/StoredProcedures/TransactionProcedures/Desposit_SP.sql"
:r "database/scripts/StoredProcedures/TransactionProcedures/Withdraw_SP.sql"
:r "database/scripts/StoredProcedures/TransactionProcedures/Transfer_SP.sql"
:r "database/scripts/StoredProcedures/TransactionProcedures/TransactionFinalizer.sql"
:r "database/scripts/StoredProcedures/TransactionProcedures/Procedure_ProcessPendingBatch.sql"
:r "database/scripts/StoredProcedures/TransactionProcedures/Procedure_ReverseTransaction.sql"

:r "database/scripts/StoredProcedures/AccountProcedures/Procedure_Account_Open.sql"
:r "database/scripts/StoredProcedures/AccountProcedures/Procedure_Account_GetInfo.sql"
:r "database/scripts/StoredProcedures/AccountProcedures/Procedure_Account_Search.sql"
:r "database/scripts/StoredProcedures/AccountProcedures/Procedure_Account_Close.sql"
:r "database/scripts/StoredProcedures/AccountProcedures/Procedure_Account_Freeze_Unfreeze.sql"
:r "database/scripts/StoredProcedures/AccountProcedures/Procedure_Account_ChangeType.sql"
:r "database/scripts/StoredProcedures/AccountProcedures/Procedure_Account_DormantSweep.sql"
:r "database/scripts/StoredProcedures/AccountProcedures/Procedure_Account_ApplyMonthlyInterest.sql"
:r "database/scripts/StoredProcedures/AccountProcedures/Procedure_AccountHistory.sql"
:r "database/scripts/StoredProcedures/AccountProcedures/Procedure_AccountType_ListOptions.sql"

:r "database/scripts/StoredProcedures/LoanProcedures/Procedure_Loan_Create.sql"
