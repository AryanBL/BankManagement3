/*
  Run this in SSMS with SQLCMD Mode enabled.
  Set ProjectRoot to the full path of the unzipped backend folder.
  Example:
  :setvar ProjectRoot "C:\Users\YourName\Downloads\bank-management-backend-v2"
*/
:setvar DbName "BankManagement"
:setvar ProjectRoot "C:\CHANGE_ME\bank-management-backend-v2"

USE [$(DbName)];
GO

